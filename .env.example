# ASIMETRIJA — secrets for local tooling. Copy to ".env" and fill in.
# ".env" is gitignored — NEVER commit real values.

# Supabase Personal Access Token (Account → Access Tokens).
# Account-level: used by the setup script and the Supabase MCP server.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Project ref of your Supabase project (the subdomain of the Project URL,
# e.g. https://abcdefgh.supabase.co  ->  abcdefgh). Filled after the project exists.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# The Odds API key — https://the-odds-api.com  (free: 500 req/month)
ODDS_API_KEY=your_the_odds_api_key

# API-Football key — https://dashboard.api-football.com  (free: 100 req/day)
API_FOOTBALL_KEY=your_api_football_key
